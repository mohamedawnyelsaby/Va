# ============================================
# VA TRAVEL - ENVIRONMENT VARIABLES
# ============================================
# ⚠️ CRITICAL: This file is for LOCAL DEVELOPMENT ONLY
# ⚠️ For PRODUCTION: Set all variables in Vercel Dashboard
# ⚠️ NEVER commit .env to Git
# ============================================

# ============================================
# 📋 SETUP INSTRUCTIONS
# ============================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your LOCAL development values
# 3. For PRODUCTION: Add to Vercel → Settings → Environment Variables
# 4. Run: npm run dev
# ============================================

# ============================================
# 🗄️ DATABASE (Required)
# ============================================
# Get from Railway.app or Vercel Postgres
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/vatravel"
# Direct (non-pooled) connection used by Prisma migrations / db push.
# Required by prisma/schema.prisma (directUrl). Same as DATABASE_URL if you do not use a pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ============================================
# 🔐 AUTHENTICATION (Required)
# ============================================
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-random-32-char-secret-here"

# Local: http://localhost:3000
# Production: https://va-pied.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# 🔒 ENCRYPTION (Required)
# ============================================
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ NEVER LOSE THIS KEY - Data encrypted with it cannot be recovered
ENCRYPTION_KEY="your-64-character-hex-encryption-key-here"

# ============================================
# π PI NETWORK (Required - Main Payment System)
# ============================================
# Get from: https://develop.pi/apps
# 
# For DEVELOPMENT (Testnet):
PI_API_KEY="your-sandbox-pi-api-key"
PI_SECRET_KEY="your-sandbox-pi-secret-key"
NEXT_PUBLIC_PI_APP_ID="your-pi-app-id"
NEXT_PUBLIC_PI_NETWORK_API_URL="https://api.minepi.com"
PI_SANDBOX="true"
NEXT_PUBLIC_PI_SANDBOX="true"

# For PRODUCTION (Mainnet):
# PI_SANDBOX="false"
# NEXT_PUBLIC_PI_SANDBOX="false"

# App-to-User (A2U) payments — the app sending Pi from its own app wallet.
# NEVER commit a real seed. Set these ONLY in your hosting provider's
# environment variables. Each network reads its own variable, so a testnet
# deployment can never touch a mainnet seed (and the other way round).
# The active network is decided by PI_SANDBOX above.
# PI_TESTNET_WALLET_SEED="S..."   # app wallet secret seed, Pi Testnet deployment only
# PI_MAINNET_WALLET_SEED="S..."   # app wallet secret seed, Pi Mainnet deployment only

# Fiat -> Pi conversion rates, one per currency you sell in, as
# "how many Pi equal 1 unit of that currency" (e.g. PI_PER_USD=3.1416 if
# 1 Pi = ~0.318 USD). REQUIRED in production for every currency used by a
# City (see prisma/schema.prisma City.currency) — the app refuses to
# create/charge a Pi payment for a currency with no rate configured rather
# than silently assuming 1:1.
# PI_PER_USD="3.1416"
# PI_PER_EUR="3.4"
# PI_PER_AED="0.855"
# PI_PER_JPY="0.021"

# ============================================
# 🧠 LOGY AI ASSISTANT (Required for /api/ai/travel)
# ============================================
# At least one of GEMINI_API_KEY / OPENAI_API_KEY is required for the AI
# assistant to respond at all. Both configured = Gemini first, OpenAI as
# fallback if every Gemini model fails.
GEMINI_API_KEY="your-gemini-api-key"
# Comma-separated, tried in order. Change this if Google retires/renames a
# model — no code change needed.
GEMINI_MODELS="gemini-2.0-flash,gemini-1.5-flash"
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"

# Real hotel search results for the AI assistant (booking-com15 on RapidAPI).
# Without this, the assistant still chats but returns no hotels.
RAPIDAPI_KEY="your-rapidapi-key"

# ============================================
# 🌱 DATABASE SEEDING (POST /api/seed)
# ============================================
# Required for the seed endpoint to accept any request, in any environment.
# Generate: openssl rand -base64 32
SEED_SECRET="generate-a-random-secret-here"
# Must NOT be "true" in production — the seed endpoint is disabled in
# production unless this is explicitly set, since it creates accounts.
# ALLOW_PROD_SEED="true"

# ============================================
# 🩺 ERROR MONITORING (Optional)
# ============================================
# Get from: https://sentry.io — enables error reporting in production.
# Without it, errors are only visible in your hosting provider's logs.
# NEXT_PUBLIC_SENTRY_DSN="https://your-key@o0.ingest.sentry.io/0"

# ============================================
# 📧 EMAIL (Required for Notifications)
# ============================================
# Option 1: SendGrid (Recommended)
# Get from: https://sendgrid.com
SENDGRID_API_KEY="SG.your-sendgrid-api-key"
EMAIL_FROM="noreply@vatravel.com"

# Receives refund-request notifications (POST /api/bookings PATCH on a
# paid booking) so they can be processed manually from the Pi Wallet app —
# there is no automated Pi refund wired up (that needs the app's own
# funded Pi wallet + private seed). Without this set, refund requests are
# still recorded on the booking but nobody is emailed about them.
ADMIN_EMAIL="you@example.com"

# Option 2: Resend (Alternative)
# RESEND_API_KEY="re_your-resend-api-key"

# ============================================
# 🖼️ MEDIA UPLOADS (Optional but Recommended)
# ============================================
# Get from: https://cloudinary.com (Free tier available)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ============================================
# ⚡ REDIS CACHE (Optional - Performance Boost)
# ============================================
# Get from: https://console.upstash.com (Free tier available)
# Without Redis: App uses in-memory cache (works fine, but resets on deploy)
UPSTASH_REDIS_REST_URL="https://your-redis-id.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ============================================
# 🌐 GOOGLE AUTH (Optional - Global Login)
# ============================================
# Get from: https://console.cloud.google.com
# Only needed if you want "Sign in with Google" button
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ============================================
# 📊 ANALYTICS (Optional)
# ============================================
# Google Analytics tracking ID (Optional)
NEXT_PUBLIC_GA_TRACKING_ID="G-XXXXXXXXXX"

# ============================================
# 🔧 SYSTEM
# ============================================
NODE_ENV="development"

# ============================================
# 📝 NOTES
# ============================================
# REQUIRED Variables (App won't work without):
#   - DATABASE_URL
#   - NEXTAUTH_SECRET
#   - NEXTAUTH_URL
#   - ENCRYPTION_KEY
#   - PI_API_KEY
#   - PI_SECRET_KEY
#   - NEXT_PUBLIC_PI_APP_ID
#   - PI_PER_<CURRENCY> for every currency you sell in (production only —
#     the app refuses to charge/credit Pi for a currency with no rate set)
#   - SEED_SECRET (required for POST /api/seed to accept any request)
#   - GEMINI_API_KEY and/or OPENAI_API_KEY (for the Logy AI assistant)
#   - SENDGRID_API_KEY or RESEND_API_KEY
#
# OPTIONAL Variables (App works without, but with reduced features):
#   - UPSTASH_REDIS_* (improves performance)
#   - CLOUDINARY_* (enables image uploads)
#   - GOOGLE_CLIENT_* (enables Google login)
#   - GA_TRACKING_ID (enables analytics)
#   - RAPIDAPI_KEY (enables real hotel search results in the AI assistant)
#   - NEXT_PUBLIC_SENTRY_DSN (error monitoring)
#   - ADMIN_EMAIL (refund-request notifications)
#
# PRODUCTION DEPLOYMENT:
#   1. Go to Vercel Dashboard → Your Project → Settings → Environment Variables
#   2. Add ONLY the variables you need
#   3. Set NEXTAUTH_URL to your production domain
#   4. Set PI_SANDBOX and NEXT_PUBLIC_PI_SANDBOX to "false"
#   5. Use PRODUCTION Pi Network keys (not sandbox)
# ============================================
